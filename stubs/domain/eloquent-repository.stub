<?php

declare(strict_types=1);

namespace {{ namespace }};

use App\Domain\{{ domain }}\Entities\{{ entity }}Entity;
use App\Domain\{{ domain }}\Repositories\{{ entity }}RepositoryInterface;
use App\Domain\Shared\Pagination\PaginatedResult;
use App\Infrastructure\{{ domain }}\Models\{{ entity }};
use App\Infrastructure\Shared\Traits\EntityMapper;

final class {{ class }} implements {{ entity }}RepositoryInterface
{
    use EntityMapper;

    public function findById({{ idType }} $id): ?{{ entity }}Entity
    {
        $model = {{ entity }}::query()->find($id);

        return $model ? $this->mapToEntity($model, {{ entity }}Entity::class) : null;
    }

    public function save({{ entity }}Entity ${{ entityVar }}): {{ entity }}Entity
    {
        $model = {{ entity }}::query()->updateOrCreate(
            ['id' => ${{ entityVar }}->id],
            [
                // TODO: Map entity properties to model attributes
            ]
        );

        return $this->mapToEntity($model, {{ entity }}Entity::class);
    }

    public function getAllPaginated(int $page, int $perPage): PaginatedResult
    {
        $paginator = {{ entity }}::query()->paginate(perPage: $perPage, page: $page);

        $entities = array_map(
            fn ({{ entity }} $model): {{ entity }}Entity => $this->mapToEntity($model, {{ entity }}Entity::class),
            $paginator->items()
        );

        return new PaginatedResult(
            items: $entities,
            total: $paginator->total(),
            perPage: $paginator->perPage(),
            currentPage: $paginator->currentPage(),
            lastPage: $paginator->lastPage()
        );
    }
}
