APP_NAME="Laravel API Kit"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PASSWORD=secret
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

JWT_SECRET=
JWT_TTL=60

# Docker Naming
DOCKER_IMAGE_NAME=laravel-api-kit/app
DOCKER_IMAGE_TAG=latest
APP_CONTAINER_NAME=laravel-api-app
SCHEDULER_CONTAINER_NAME=laravel-api-scheduler
WORKER_CONTAINER_NAME=laravel-api-worker
DB_CONTAINER_NAME=laravel-api-db
REDIS_CONTAINER_NAME=laravel-api-redis

# Service Activation (true/false)
WITH_HORIZON=false
WITH_SCHEDULER=true
WITH_REVERB=false

OCTANE_SERVER=frankenphp
